# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Git build stamp — generated per-build from git (ops/scripts/stamp-build-info.js),
# baked into the image and read by GET /api/system/version. Never committed.
build-info.json

# Environment
.env
.env.local
.env.*.local
!.env.example

# Prisma
apps/backend/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*

# Local development assistant config — per-checkout, not tracked

# Art / brand source assets (not needed for the build — the app ships
# apps/frontend/public/logo.png)
art/

# Internal security reports / audits — never commit or publish. Keep all
# security review files in this folder.
security/
SECURITY_REVIEW*.md

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/
.nyc_output/

# Runtime data
uploads/
data/
tmp/

# Redundant legacy user-manual binaries (superseded by the Core manual). The
# full root ARCHITECTURE.md is kept local until its stale enterprise sections
# are rewritten for the community repo (then it gets published too).
/ARCHITECTURE.md
/docs/UltraTorrent-User-Manual.docx
/docs/UltraTorrent-User-Manual.pdf

# Recall session logs (local tooling scratch; history.md runs to megabytes).
.recall/

# Private host inventory for docs/OPERATIONS.md — real aliases/addresses/paths.
# The repo is public; identities never go in it.
ops/hosts.local.md
ops/*.local.md

# Output from the /audit plugin — review reports, regenerated on demand.
audit/

# Private conversation logs — full memory across compaction, never published.
ops/conversation-logs/

# UltraTorrent Console build output — binaries are built, never committed.
clients/console/dist/

# Transient backend build used by the fresh-build+boot gate. Never committed;
# it otherwise shows up as untracked work for anyone sharing this tree.
apps/backend/.bootcheck/

# Installer build output — binaries are built, never committed.
clients/installer/dist/
